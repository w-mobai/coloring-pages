# ============================================
# 环境变量配置示例
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 填写实际的配置值
# 3. .env.local 不会被提交到 Git（包含敏感信息）
# ============================================

# ============================================
# 核心配置（必须填写）
# ============================================

# 应用基础信息
NEXT_PUBLIC_APP_URL = "https://whatgenerationami.online"
NEXT_PUBLIC_APP_NAME = "ColorFun"
NEXT_PUBLIC_THEME = "default"
NEXT_PUBLIC_APPEARANCE = "system"

# 数据库配置
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""  # 填写你的数据库连接字符串
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# 认证密钥（生成方式：openssl rand -base64 32）
AUTH_SECRET = ""  # 生成一个随机密钥

# ============================================
# 第三方服务配置（可选）
# ============================================
# 以下配置可以在管理后台 /admin/settings 中设置
# 无需在此文件中配置
# ============================================
# - Google Analytics（谷歌分析）
# - Google Ads（谷歌广告）
# - Clarity（微软 Clarity）
# - Plausible（隐私分析）
# - OpenPanel（开源分析）
# - 支付服务（Stripe、PayPal、Creem）
# - 邮件服务（Resend）
# - 存储服务（S3、R2）
# - AI 服务（OpenAI、Gemini、Replicate）
# ============================================
